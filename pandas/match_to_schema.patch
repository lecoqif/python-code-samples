+    def match_to_schema(
+        self,
+        schema: Mapping[str, Dtype],
+        *,
+        missing_columns: Literal["raise", "insert"] = "raise",
+        extra_columns: Literal["raise", "drop"] = "raise",
+        cast: bool = False,
+    ) -> DataFrame:
+        """Return an independent frame with columns and dtypes in schema order.
+
+        Missing columns may be inserted if their dtype supports missing values;
+        extra columns may be dropped. cast=True uses normal astype semantics,
+        which need not be lossless. The input is unchanged on success or failure.
+        Supports native NumPy integer, bool, float32/64, pandas nullable numeric
+        and boolean dtypes, and Python-backed nullable strings. Labels must be
+        unique strings. Row indexes (including duplicate labels) are preserved.
+        Scalar mutations are isolated; nested Python objects are not deep-copied.
+        """
+        if not isinstance(schema, Mapping):
+            raise TypeError("schema must be a mapping")
+        if isinstance(self.columns, MultiIndex):
+            raise TypeError("MultiIndex columns are not supported")
+        if not all(isinstance(name, str) for name in self.columns):
+            raise TypeError("input column labels must be strings")
+        if not self.columns.is_unique:
+            raise ValueError("input column labels must be unique")
+        if missing_columns not in ("raise", "insert"):
+            raise ValueError("missing_columns must be 'raise' or 'insert'")
+        if extra_columns not in ("raise", "drop"):
+            raise ValueError("extra_columns must be 'raise' or 'drop'")
+        if not isinstance(cast, (bool, np.bool_)):
+            raise TypeError("cast must be boolean")
+
+        existing_columns = set(self.columns)
+        if missing_columns == "raise":
+            for name in schema:
+                if name not in existing_columns:
+                    raise ValueError(f"missing column: {name}")
+        if extra_columns == "raise":
+            for name in self.columns:
+                if name not in schema:
+                    raise ValueError(f"extra column: {name}")
+
+        dtypes = {}
+        for name, specification in schema.items():
+            if not isinstance(name, str):
+                raise TypeError("schema keys must be strings")
+            if specification is None:
+                raise TypeError(f"missing dtype for {name}")
+            dtype = pandas_dtype(specification)
+            if isinstance(dtype, np.dtype):
+                supported = dtype.isnative and (
+                    (dtype.kind in "iu" and dtype.itemsize in (1, 2, 4, 8))
+                    or (dtype.kind == "f" and dtype.itemsize in (4, 8))
+                    or dtype.kind == "b"
+                )
+            elif isinstance(dtype, StringDtype):
+                supported = dtype.storage == "python" and dtype.na_value is NA
+            else:
+                supported = isinstance(dtype, BaseMaskedDtype) and dtype.name in {
+                    "Int8",
+                    "Int16",
+                    "Int32",
+                    "Int64",
+                    "UInt8",
+                    "UInt16",
+                    "UInt32",
+                    "UInt64",
+                    "Float32",
+                    "Float64",
+                    "boolean",
+                }
+            if not supported:
+                raise TypeError(f"unsupported dtype {dtype} for {name}")
+            dtypes[name] = dtype
+
+        columns = {}
+        for name, dtype in dtypes.items():
+            if name not in existing_columns:
+                if isinstance(dtype, np.dtype):
+                    if dtype.kind != "f":
+                        raise TypeError(
+                            f"{dtype} cannot represent a missing column: {name}"
+                        )
+                    missing = np.nan
+                else:
+                    missing = NA
+                column = Series(missing, index=self.index, dtype=dtype)
+            else:
+                column = self[name].copy(deep=True)
+                if column.dtype != dtype:
+                    if not cast:
+                        raise TypeError(
+                            f"dtype mismatch for {name}: {column.dtype} != {dtype}"
+                        )
+                    column = column.astype(dtype)
+            columns[name] = column
+
+        result = DataFrame(columns, index=self.index.copy(deep=True))
+        result.columns.name = self.columns.name
+        return result
+
