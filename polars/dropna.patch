+    def dropna(
+        self,
+        *,
+        thresh: int | None = None,
+        subset: str | Sequence[str] | None = None,
+        how: Literal["any", "all"] | None = None,
+    ) -> LazyFrame:
+        """Drop rows with top-level nulls or floating NaNs in selected columns.
+
+        By default every selected value must be valid. how="all" keeps rows
+        with at least one valid value; thresh requires that many valid values
+        and is mutually exclusive with how. subset accepts column names only.
+        An empty subset keeps all rows unless how="all" or thresh is positive.
+        Schema resolution is allowed, but the lazy method executes no rows.
+        """
+        if how is not None and how not in ("any", "all"):
+            raise ValueError("how must be None, 'any', or 'all'")
+
+        if thresh is not None and (not isinstance(thresh, int) or isinstance(thresh, bool)):
+            raise TypeError("thresh must be a Python int, excluding bool")
+
+        if thresh is not None and thresh < 0:
+            raise ValueError("thresh must be nonnegative")
+
+        if how is not None and thresh is not None:
+            raise TypeError("how and thresh are mutually exclusive")
+
+        schema = self.collect_schema()
+        if subset is None:
+            subset = schema.names()
+
+        if isinstance(subset, str):
+            subset = [subset]
+
+        if not isinstance(subset, Sequence):
+            raise TypeError("subset must be a column name or sequence of names")
+        seen = set()
+        for name in subset:
+            if not isinstance(name, str):
+                raise TypeError("subset entries must be strings")
+            if name not in schema:
+                raise ColumnNotFoundError(name)
+            if name in seen:
+                raise ValueError(f"duplicate subset column: {name}")
+            seen.add(name)
+
+        if thresh is None:
+            thresh = 1 if how == "all" else len(subset)
+
+        valid_columns = []
+
+        for name in subset:
+            column = F.col(name)
+            mask = column.is_not_null()
+
+            if schema[name].is_float():
+                mask = mask & column.is_not_nan()
+
+            valid_columns.append(mask)
+
+        valid_count = F.sum_horizontal(valid_columns) if valid_columns else F.lit(0)
+
+        return self.filter(valid_count >= thresh)
+
     def drop_nans(
         self,
         subset: ColumnNameOrSelector | Collection[ColumnNameOrSelector] | None = None,
