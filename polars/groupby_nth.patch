+    def nth(
+        self,
+        n: int | list[int] | tuple[int, ...],
+        *,
+        dropna: Literal["any", "all"] | None = None,
+    ) -> LazyFrame:
+        """
+        Select original rows by their position within each group.
+
+        Parameters
+        ----------
+        n
+            An integer or list/tuple of integers, using Polars expression coercion.
+            Positions are zero-based; negative positions count from the end.
+            Out-of-bounds positions are skipped. Repeated positions and aliases
+            select each row only once.
+        dropna
+            Exclude rows with any or all values missing before assigning positions.
+            Missing values are top-level nulls or floating NaNs across all original
+            columns, including keys. None keeps every row eligible.
+
+        Returns
+        -------
+        LazyFrame
+            Selected rows in original input order, with unchanged columns and dtypes.
+
+        Notes
+        -----
+        Supports ordinary grouping by distinct existing column names. Expressions,
+        selectors, named keys, generators, rolling/dynamic groups, and groups with
+        having predicates are not supported. Key dtypes follow native grouping
+        support. Schema resolution is allowed; constructing the plan executes no rows.
+
+        Examples
+        --------
+        >>> lf = pl.LazyFrame({"value": [10, 20, 30], "key": ["a", "b", "a"]})
+        >>> lf.group_by("key").nth(-1).collect()
+        shape: (2, 2)
+        ┌───────┬─────┐
+        │ value ┆ key │
+        │ ---   ┆ --- │
+        │ i64   ┆ str │
+        ╞═══════╪═════╡
+        │ 20    ┆ b   │
+        │ 30    ┆ a   │
+        └───────┴─────┘
+        """
+        positions = n if isinstance(n, (list, tuple)) else [n]
+        if dropna is not None and dropna not in ("any", "all"):
+            msg = "dropna must be None, 'any', or 'all'"
+            raise ValueError(msg)
+
+        if self._frame is None or not self._keys or self._has_having:
+            msg = "nth requires ordinary column-name grouping without having predicates"
+            raise NotImplementedError(msg)
+        # Resolve the native grouping schema so duplicate/missing keys follow
+        # the same rules as other group operations, without executing rows.
+        self.agg().collect_schema()
+        frame = self._frame
+
+        if dropna is not None:
+            schema = frame.collect_schema()
+            missing = []
+            for name, dtype in schema.items():
+                column = F.col(name)
+                is_missing = column.is_null()
+                if dtype.is_float():
+                    is_missing = is_missing | column.is_nan().fill_null(False)
+                missing.append(is_missing)
+            excluded = (
+                F.any_horizontal(missing)
+                if dropna == "any"
+                else F.all_horizontal(missing)
+            )
+            frame = frame.filter(~excluded)
+
+        # Positive and negative positions identify the same original rows. Filtering
+        # preserves input order and naturally deduplicates repeated requests/aliases.
+        position = F.int_range(F.len(), dtype=Int64).over(self._keys)
+        size = F.len().cast(Int64).over(self._keys)
+        return frame.filter(
+            position.is_in(positions) | (position - size).is_in(positions)
+        )
