+    def resize(self, maxsize: int | float) -> tuple[tuple[Any, Any], ...]:
+        """Change capacity, returning live evictions in this cache's policy order.
+
+        Expired entries are removed separately by timed caches. Weighted caches
+        measure capacity using getsizeof, rather than their number of entries.
+        User-defined popitem failures are propagated; earlier evictions are not
+        rolled back. External synchronization is required for concurrent access.
+        """
+        if not isinstance(maxsize, (int, float)) or isinstance(maxsize, bool):
+            raise TypeError("maxsize must be an int or float, excluding bool")
+        if maxsize != maxsize or maxsize < 0:
+            raise ValueError("maxsize must be nonnegative and not NaN")
+        evicted = []
+        while self.__currsize > maxsize:
+            evicted.append(self.popitem())
+        self.__maxsize = maxsize
+        return tuple(evicted)
 
