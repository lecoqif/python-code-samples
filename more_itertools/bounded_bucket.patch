+class _BucketIterator:
+    """Keep a child usable after BufferError or a transient source failure."""
+
+    def __init__(self, parent, value) -> None:
+        self._parent = parent
+        self._value = value
+        self._is_finished = False
+
+    def __iter__(self):
+        return self
+
+    def __next__(self):
+        if self._is_finished:
+            raise StopIteration
+
+        try:
+            return next(self._parent._get_values(self._value))
+        except StopIteration:
+            self._is_finished = True
+            raise
 
